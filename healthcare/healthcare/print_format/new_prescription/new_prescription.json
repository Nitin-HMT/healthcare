 "html": "<div >\n<style>\n/*\t.print-format table, .print-format tr, */\n/*\t.print-format td, .print-format div, .print-format p {*/\n/*\t\tline-height: 120%;*/\n/*\t\tvertical-align: middle;*/\n/*\t}*/\n/*\t@media screen {*/\n/*\t\t.print-format {*/\n/*\t\t\twidth: 8.25in;*/\n/*\t\t\tpadding: 0.20in;*/\n/*\t\t\tmin-height: 11.5in;*/\n/*\t\t}*/\n/*\t}*/\n</style>\n{%- from \"templates/print_formats/standard_macros.html\" import add_header, add_footer,\n     render_field -%}\n\t \n    {% if letter_head and not no_letterhead -%}\n    <div class=\"letter-head\">{{ letter_head }}</div>\n    <hr>\n    {% else %}\n\t\n<header id=\"header-html\" class=\"hidden-pdf\">\n    \n<table>\n    <tbody>\n        <tr style=\"padding: 0; margin: 0;\">\n            <td class=\"text-left\" width=\"12%\" style=\"padding: 0; margin: 0;\">\n                <img src=\"/files/dr_maskara_no_bg.png\">\n            </td>\n            <td class=\"text-left\" width=\"55%\" style=\"padding: 0; margin: 0;\">\n                <div><u><b>{{ doc.practitioner_name }}</b></u></div>\n                <small class=\"sub-heading\">\n                    {% set doct = frappe.get_doc('Healthcare Practitioner', doc.practitioner) %}\n                    <p>{{ doct.portfolio }}|{{ doct.qualifications }}<br/>\n                    <b>Regn No.:</b> {{ doct.registration_no }}</p>\n                </small>\n            </td>\n            <td class=\"text-right\" width=\"33%\" style=\"padding: 0; margin: 0;\">\n                <h5><b><u>Mobile:</u></b>{{ doct.mobile_phone }}</h5>\n                {% if doct.further_information %}\n                <h5><b><u>Associated With:</u></b><br/>\n                \n                {% set list5 = doct.further_information.split(',') %}\n\t            {% for l in list5 %}\n\t                {{l}}<br>\n\t            {% endfor %}\n\t            \n                </h5>\n                {% endif %}\n            </td>\n        </tr>\n        <!--<tr style=\"height: 5px; padding: 0; margin: 0;\">-->\n        <!--    <td class=\"text-center\" colspan=\"3\" style=\"padding: 0; margin: 0; height: 5px;\">-->\n        <!--        <h5 style=\"margin: 0; padding: 0;\">-->\n        <!--            <b><u>Patient Advise</u></b>-->\n        <!--        </h5>-->\n        <!--    </td>-->\n        <!--</tr>-->\n        <tr style=\"height: 5px; padding: 0; margin: 0;\">\n            <td class=\"text-left\" colspan=\"2\" style=\"padding: 0; margin: 0; height: 5px;\">\n                <h5 style=\"margin: 0; padding: 0;\">\n                    {% set pat = frappe.get_doc('Patient', doc.patient) %}\n                   <b>{{pat.patient_name}}</b> | {{doc.patient_sex}} | {{doc.patient_age}} yrs\n                </h5>\n            </td>\n            <td class=\"text-right\" colspan=\"1\" style=\"padding: 0; margin: 0; height: 5px;\">\n                <h5 style=\"margin: 0; padding: 0;\">\n                    {{ doc.get_formatted('encounter_date') }}\n                </h5>\n            </td>\n        </tr>\n    </tbody>\n</table>\n</header>\n    {%- endif %}\n\n\n\n<table class=\"table\" >\n    <tbody>\n    <tr style=\"padding: 0; margin: 0;\">\n        <td width=\"100%\" style=\"padding: 0; margin: 0;\">\n            <div style=\"padding: 0; margin: 0;\">\n    \t\t    <div class=\"text-left value\">\n    \t\t       <u>Vitals:</u>\n    \t\t    BP:{{doc.bp}}, Pulse: {{doc.pulse}} bpm, SpO<sub>2</sub>: {{doc.spo2}}, Wt: {{doc.weight}} kgs, Ht: {{doc.height}}, BMI: {{doc.bmi}}\n    \t        </div>\n    \t </td>\n    </tr>\n    <tr style=\"padding: 0; margin: 0;\">\n        <td width=\"100%\" style=\"padding: 0; margin: 0;\">\n    \t      <div style=\"padding: 0px; margin: 0;\">\n    \t      <div class=\"col-xs-6 text-left\" style=\"padding: 0; margin: 0;\">\n    \t        {%- if doc.patient_history -%}<label><u>Patient History:</u></label>{% endif %}\n    \t      {%- if doc.patient_history -%}\n    \t      <div class=\"text-left value\">\n    \t\t    {%- for item in doc.patient_history -%}\n                {{item.history_type.replace(\"PED\",\"History\")}} &#8594 \n                {{item.details.replace(\"-\"+doc.co_abbr,\"\")}}{%- if (item.duration or item.comments) -%}({%- if item.duration -%}{{item.duration}}{% endif %} {%- if item.comments -%}{%- if (item.duration and item.comments) -%},{% endif %}{{item.comments}}{% endif %}){% endif %}\n                <br/>\n                {%- endfor -%}\n    \t      </div></div>\n\t      </div>\n\t      {% endif %}\n\t      <div style=\"padding: 0; margin: 0;\">\n    \t      <div class=\"col-xs-6 text-left\" style=\"padding: 0; margin: 0;\">\n    \t        {%- if doc.diagnosis -%}<label><u>Diagnosis:</u></label>{% endif %}\n    \t      {%- if doc.diagnosis -%}\n    \t      <div class=\"text-left value\">\n    \t      {%- for item in doc.diagnosis -%}{{ item.diagnosis }}{%- if not loop.last %}<br/>{% endif %} {%- endfor -%}\n    \t      </div></div>\n\t      </div>\n\t      {% endif %}\n\t      <div style=\"padding: 0; margin: 0;\">\n    \t      <div class=\"text-left\" style=\"padding: 0; margin: 0;\">\n    \t        {%- if doc.present_complaint -%}<label><u>Current Obx:</u></label>{% endif %}\n    \t      \n    \t      {%- if doc.present_complaint -%}\n    \t      <div class=\"text-left value\">\n    \t\t    {%- for item in doc.present_complaint -%}{{ item.complaint }}{%- if (item.comments) -%}({{ item.comments }}){% endif %}{%- if not loop.last %}<br/>{% endif %} {%- endfor -%}\n    \t      </div></div>\n\t      </div>\n\t      {% endif %}\n\t       {%- if doc.further_description -%}\n\t      <div class=\"row\" style=\"padding: 0; margin: 0;\">\n    \t      <div class=\"col-xs-6 text-justify value\" style=\"padding: 0; margin: 0;\">\n    \t      {{doc.further_description}}\n    \t      </div>\n\t      </div>{% endif %}\n        </td>\n    </tr>\n    <tr style=\"padding: 0; margin: 0;\"><td width=\"100%\" style=\"padding: 0; margin: 0;\">\n            Rx,\n        {%- if doc.lab_test_prescription -%}\n        <div class=\"row\" style=\"padding: 0; margin: 0;\">\n            <div class=\"col-xs-2 text-left\" style=\"padding: 0; margin: 0;\">\n    \t        <label><u>Investigations</u></label>\n\t        </div>\n\t        <div class=\"col-xs-10 text-left value\">\n\t            {%- for item in doc.lab_test_prescription -%}{{ item.lab_test_name }}{%- if not loop.last %}, {% else %}<br/>{% endif %}{%- endfor -%}\n\t        </div>\n\t     </div>\n\t      </div>\n\t      {% endif %}\n\t      {%- if doc.procedure_prescription -%}\n        <div class=\"row\" style=\"padding: 0; margin: 0;\">\n            <div class=\"col-xs-2 text-left\" style=\"padding: 0; margin: 0;\">\n    \t        <label><u>Procedure</u></label>\n\t        </div>\n\t        <div class=\"col-xs-10 text-left value\">\n\t            {%- for item in doc.procedure_prescription -%}\n\t            {{ item.procedure_name }}{%-if (item.date or item.comments) -%}({%-if item.date -%}{{item.get_formatted('date')}} {%-if (item.date and item.comments) -%},{% endif %}{% endif %} {%-if item.comments -%}{{item.comments}}{% endif %}){% endif %}{%- if not loop.last %}<br/>{% else %}{% endif %} {%- endfor -%}\n\t        </div>\n\t     </div>\n\t      </div>\n\t      {% endif %}\n\t      \n\t      {%- if doc.opd_medication -%}\n        <div class=\"row\" style=\"padding: 0; margin: 0;\">\n\t    <div class=\"col-xs-12 text-left value\" style=\"padding: 0; margin: 0;\">\n\t    <table class=\"table table-bordered\" style=\"padding: 0; margin: 0;\">\n        \t<thead>\n        \t\t<tr style=\"padding: 0; margin: 0;\">\n        \t\t\t<th width=\"40%\" class=\"text-left\">{{ _(\"Medication\") }}</th>\n        \t\t\t<th width=\"12%\" class=\"text-left\">{{ _(\"Dosage\") }}</th>\n        \t\t\t<th width=\"12%\" class=\"text-left\">{{ _(\"Period\") }}</th>\n        \t\t\t<th width=\"36%\" class=\"text-center\">{{ _(\"Instructions\") }}</th>\n        \t\t</tr>\n        \t</thead>\n        \t<tbody style=\"padding: 0; margin: 0;\">\n\t            {%- for item in doc.opd_medication -%}\n        \t\t<tr style=\"padding: 0; margin: 0;\">\n        \t\t\t<td class=\"text-left\" style=\"padding: 0; margin: 0;\">{{item.medicine_form}} {{ item.medicine.replace(\"-\"+doc.co_abbr,\"\")}}\n        \t\t\t<br/><small><i>{%- if item.generic_name -%}{{item.generic_name}} {% endif %}</i></small>\n        \t\t\t</td>\n        \t\t\t<td class=\"text-left\" style=\"padding: 0; margin: 0;\">{{item.dosage}}</td>\n        \t\t\t<td class=\"text-left\" style=\"padding: 0; margin: 0;\">{{item.period}}</td>\n        \t\t\t<td class=\"text-left\" style=\"padding: 0; margin: 0;\">{{item.comments}}</td>\n        \t\t</tr>\n\t\t        {%- endfor -%}\n\t\t    </tbody>\n\t\t </table>\n\t   </div>\n\t     </div>\n\t      </div>\n\t      {% endif %}\n\t      </td>\n    </tr>\n    <tr style=\"padding: 0; margin: 0;\">\n        <td width=\"100%\" style=\"padding: 0; margin: 0;\">\n\t      {%- if doc.refer_to -%}\n        <div style=\"padding: 1px; margin: 0;\">\n            <div class=\"col-xs-6 text-left\" style=\"padding: 0; margin: 0;\">\n    \t        <label><u>Reffered To</u></label>\n\t        \n\t        <div class=\"text-left value\">\n\t            {% set ref_dr = frappe.get_doc('Referring Doctor', doc.refer_to) %}\n\t            {{ref_dr.doctor_name}}, {{ref_dr.more_information}}\n\t        </div></div>\n\t     </div>\n\t      </div>\n\t      {% endif %}\n\t      {%- if doc.follow_up -%}\n        <div style=\"padding: 0; margin: 0;\">\n            <div class=\"col-xs-6 text-left\" style=\"padding: 0; margin: 0;\">\n    \t        <label><u>Follow-Up</u></label>\n\t        <div class=\"text-left value\">\n\t            {{ doc.get_formatted('next_follow_up_date') }}({{doc.follow_up}} days)\n\t        </div></div>\n\t     </div>\n\t      </div>\n\t      {% endif %}\n\t      {%- if doc.further_advice -%}\n\t      <div class=\"row\" style=\"padding: 0; margin: 0;\">\n    \t      <div class=\"col-xs-12 text-justify value\" style=\"padding: 0; margin: 0;\">\n    \t      {{doc.further_advice}}\n    \t      </div>\n\t      </div>{% endif %}\n        </td></tr>\n    <tr style=\"padding: 0; margin: 0;\">\n        <td style=\"padding: 0; margin: 0;\" colspan=\"2\" align=\"right\">\n            <div class=\"row\" style=\"padding: 0; margin: 0;\">\n    \t      <div class=\"col-xs-9 text-left value\" style=\"font-family:'Courier New'\">\n    \t          {% if (doc.patient_history or doc.diagnosis) -%}\n    \t          {%- for item in doc.diagnosis -%}{%- if item.lifestyle_advise -%}<small>{{ item.diagnosis }}:{{item.lifestyle_advise}}</small><br/> {% endif %} {%- endfor -%}\n    \t          {%- for item in doc.patient_history -%}{%- if item.history_type==\"PED\"-%}\n    \t          {% set life_hist = frappe.get_doc('Diagnosis', item.details) %}\n    \t          <small>{%- if life_hist.lifestyle_advise -%}{{ item.details }}: {{life_hist.lifestyle_advise}}<br/>{% endif %}</small> {% endif %} {%- endfor -%}\n    \t          {%- endif -%}\n    \t      </div>\n    \t      <div class=\"col-xs-3 text-center value\" >\n    \t\t\t_______________________\n    \t\t\tDoctor's Signature\n    \t      </div>\n    \t      </div></td>\n    </tr>\n    </tbody>\n</table>\n{% if print_settings.repeat_header_footer %}\n    \t<div id=\"footer-html\">\n    \t\t<div>\n    \t\t    \n    \t\t<div style=\"position:absolute; bottom:0;\" class=\"row hidden-pdf\">\n    \t\t    {% set doct = frappe.get_doc('Healthcare Practitioner', doc.practitioner) %}\n    \t\t    {% set comp = frappe.get_doc('Company', doc.company) %}\n    \t\t     {% if (comp.registration_details) %}\n    \t\t    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 384 512\" width=\"10\" height=\"12\"><path d=\"M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z\"/></svg>\n    \t\t    <small>{{comp.registration_details}}</small><br/>{%- endif -%}\n    \t\t    {% if (doct.practioner_timing) -%}\n    \t\t    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\" width=\"10\" height=\"12\"><path d=\"M464 256A208 208 0 1 1 48 256a208 208 0 1 1 416 0zM0 256a256 256 0 1 0 512 0A256 256 0 1 0 0 256zM232 120l0 136c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2 280 120c0-13.3-10.7-24-24-24s-24 10.7-24 24z\"/></svg>\n    \t\t    <small>{{doct.practioner_timing}}</small><br/>{%- endif -%}\n    \t\t    {% if (comp.email) -%}\n    \t\t    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\" width=\"10\" height=\"12\"><path d=\"M64 112c-8.8 0-16 7.2-16 16l0 22.1L220.5 291.7c20.7 17 50.4 17 71.1 0L464 150.1l0-22.1c0-8.8-7.2-16-16-16L64 112zM48 212.2L48 384c0 8.8 7.2 16 16 16l384 0c8.8 0 16-7.2 16-16l0-171.8L322 328.8c-38.4 31.5-93.7 31.5-132 0L48 212.2zM0 128C0 92.7 28.7 64 64 64l384 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64L64 448c-35.3 0-64-28.7-64-64L0 128z\"/></svg>\n    \t\t    <small>{{comp.email}}</small><br/>{%- endif -%}\n    \t\t    <small>{{doc.name}}</small>\n    \t\t</div>\n    \t\t<div class=\"row visible-pdf\" style=\"padding: 0; margin: 0;\">\n    \t\t<div>\n    \t\t    {% set doct = frappe.get_doc('Healthcare Practitioner', doc.practitioner) %}\n    \t\t    {% set comp = frappe.get_doc('Company', doc.company) %}\n    \t\t     {% if (comp.registration_details) -%}\n    \t\t    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 384 512\" width=\"10\" height=\"12\"><path d=\"M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z\"/></svg>\n    \t\t    <small>{{comp.registration_details}}</small><br/>{%- endif -%}\n    \t\t    {% if (doct.practioner_timing) -%}\n    \t\t    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\" width=\"10\" height=\"12\"><path d=\"M464 256A208 208 0 1 1 48 256a208 208 0 1 1 416 0zM0 256a256 256 0 1 0 512 0A256 256 0 1 0 0 256zM232 120l0 136c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2 280 120c0-13.3-10.7-24-24-24s-24 10.7-24 24z\"/></svg>\n    \t\t    <small>{{doct.practioner_timing}}</small><br/>{%- endif -%}\n    \t\t    {% if (comp.email) -%}\n    \t\t    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\" width=\"10\" height=\"12\"><path d=\"M64 112c-8.8 0-16 7.2-16 16l0 22.1L220.5 291.7c20.7 17 50.4 17 71.1 0L464 150.1l0-22.1c0-8.8-7.2-16-16-16L64 112zM48 212.2L48 384c0 8.8 7.2 16 16 16l384 0c8.8 0 16-7.2 16-16l0-171.8L322 328.8c-38.4 31.5-93.7 31.5-132 0L48 212.2zM0 128C0 92.7 28.7 64 64 64l384 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64L64 448c-35.3 0-64-28.7-64-64L0 128z\"/></svg>\n    \t\t    <small>{{comp.email}}</small>{%- endif -%}\n    \t\t</div>\n    \t\t<div class=\"text-right small page-number visible-pdf\">\n    \t\t    \n    \t\t\t<small>{{doc.name}}</small><br/>\n    \t\t\t<small style=\"text-right\">{{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}</small>\n    \t\t</div>\n    \t\t</div>\n    \t\t</div>\n    \t</div>\n    \t{% endif %}",

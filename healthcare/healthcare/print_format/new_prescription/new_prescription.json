 "css": "\t.print-format table, .print-format tr, \n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 100%;\n\t\tvertical-align: middle;\n\t\t/*vertical-align: baseline;*/\n\t}\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 8.25in;\n\t\t\tpadding: 0.15in;\n\t\t\tmin-height: 11.5in;\n\t\t}\n\t}\n",
 "custom_format": 1,
